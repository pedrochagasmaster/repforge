{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker",
      "WebWorker.Iterable"
    ],
    "skipLibCheck": true
  },
  "include": [
    "../../src/release/**/*.js",
    "../../src/training/identity.js",
    "../../src/training/metrics.js",
    "../../src/persistence/preferences.js",
    "../../src/platform/files.js",
    "../../src/platform/notifications.js",
    "../../src/platform/install.js",
    "../../src/platform/catalog.js"
  ]
}
