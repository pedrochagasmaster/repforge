{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker",
      "WebWorker.Iterable"
    ],
    "skipLibCheck": true
  },
  "include": [
    "../../src/release/**/*.js",
    "../../src/training/**/*.js",
    "../../src/ui/focus/**/*.js",
    "../../src/ui/entry/pickers.js",
    "../../src/app/entry.js",
    "../../src/ui/entry/controller.js",
    "../../src/ui/entry/view.js",
    "../../src/persistence/**/*.js",
    "../../src/platform/**/*.js",
    "../../src/interchange/**/*.js",
    "../../src/app/session.js",
    "../../src/app/workout.js",
    "../../src/app/read-models.js",
    "../../src/app/settings.js",
    "../../src/app/profile.js",
    "../../src/app/interchange.js",
    "../../src/ui/settings/**/*.js",
    "../../src/ui/shell.js",
    "../../src/ui/workout/session-sheet.js"
  ]
}
