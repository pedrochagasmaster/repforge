{
  "name": "Taurifer",
  "short_name": "Taurifer",
  "description": "Local-only progressive overload tracker for machines, cables, dumbbells, barbells, and bodyweight.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F2EF",
  "theme_color": "#F4F2EF",
  "categories": [
    "health",
    "fitness",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
