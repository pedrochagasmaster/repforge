{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taurifer-managed-program-import-local",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "IMPORT_BUDGET", "class_name": "ImportBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImportBudget"] }],
  "vars": {
    "MANAGED_IMPORT_ENABLED": "false",
    "MANAGED_IMPORT_ALLOWED_ORIGIN": "https://taurifer.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF5mnFwEyHhOD9pl"
  },
  "env": {
    "production": {
      "name": "taurifer-managed-program-import",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": false },
      "routes": [
        { "pattern": "taurifer.com/api/program-import*", "zone_name": "taurifer.com" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "IMPORT_BUDGET", "class_name": "ImportBudget" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImportBudget"] }],
      "vars": {
        "MANAGED_IMPORT_ENABLED": "false",
        "MANAGED_IMPORT_ALLOWED_ORIGIN": "https://taurifer.com",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAF5mnFwEyHhOD9pl"
      }
    }
  }
}
