# Superseded by the scheduled watcher Worker (#397, RUNBOOK "Scheduled watcher
# Worker"). Kept as the rollback path; the cutover disables and removes it.
# Runs the owner-attested production health pass every two minutes.
# Stop with: systemctl --user disable --now taurifer-transfer-health.timer
# When it stops, new creates fail closed (503) within five minutes.
[Unit]
Description=Every two minutes: Taurifer install-transfer production health pass

[Timer]
OnBootSec=1min
OnUnitActiveSec=2min
AccuracySec=10s
Unit=taurifer-transfer-health.service

[Install]
WantedBy=timers.target
