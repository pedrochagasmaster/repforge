{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taurifer-install-transfer-watcher",
  "main": "src/watcher.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "services": [
    {
      "binding": "TRANSFER",
      "service": "taurifer-install-transfer"
    }
  ],
  "vars": {
    "TRANSFER_SERVICE_ORIGIN": "https://taurifer.com",
    "TRANSFER_ALERT_REPO": "pedrochagasmaster/repforge"
  },
  "observability": {
    "enabled": true
  }
}
