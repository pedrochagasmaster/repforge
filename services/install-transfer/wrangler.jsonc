{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taurifer-install-transfer-local",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "durable_objects": {
    "bindings": [
      {
        "name": "TRANSFER_OBJECTS",
        "class_name": "TransferDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TransferDurableObject"]
    }
  ]
}
